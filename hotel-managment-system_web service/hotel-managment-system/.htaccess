# Simple .htaccess for InfinityFree
RewriteEngine On

# Route /api/ requests to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^ index.php [L]

# Allow static files to load directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(jpg|jpeg|png|gif|css|js|ico|svg|woff|woff2|ttf|eot|html)$ - [L]

# Route root to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^$ index.php [L]

# Disable directory listing
Options -Indexes

