# Hotel Management System - .htaccess
# Generic configuration for root deployment

RewriteEngine On
RewriteBase /

# Prevent directory listing
Options -Indexes

# Allow access to static files (CSS, JS, images, HTML pages)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route everything that isn't a file/directory to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# PHP Settings (Optional, may be ignored by shared hosting)
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    php_value post_max_size 50M
    php_value upload_max_filesize 50M
</IfModule>
